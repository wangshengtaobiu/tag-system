# =============================================================================
# tag-system — .gitignore (v0.1-stable)
# =============================================================================
# Policy:
#   Ignore ONLY:
#   - runtime artifacts
#   - cache/temp files
#   - logs
#   - local environments
#   - generated outputs
#
#   NEVER ignore:
#   - source code
#   - configs
#   - schemas
#   - public docs
#   - test datasets
# =============================================================================

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class

# Packaging
build/
dist/
site/
.eggs/
*.egg
*.egg-info/
pip-wheel-metadata/

# Native extensions
*.so
*.dylib
*.dll

# PyInstaller
*.manifest
*.spec

# =============================================================================
# Virtual Environments
# =============================================================================
venv/
.venv/
env/
ENV/

# =============================================================================
# Python Tooling
# =============================================================================

# pytest
.pytest_cache/

# mypy
.mypy_cache/

# Ruff
.ruff_cache/

# coverage
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# =============================================================================
# IDE / Editor
# =============================================================================
.vscode/
.idea/

*.swp
*.swo
*~

# VSCode test artifacts
.history/

# =============================================================================
# Qoder / Agent IDE
# =============================================================================
.qoder/

# =============================================================================
# Runtime Outputs — ontology_factory
# =============================================================================

# Pipeline intermediate outputs
ontology_factory/work/

# Generated exports
ontology_factory/exports/*
!ontology_factory/exports/.gitkeep

# Metrics / observations / failed cases
ontology_factory/metrics/

# =============================================================================
# Runtime Outputs — tag_acquisition
# =============================================================================

# Future raw cache / snapshots
tag_acquisition/raw/
tag_acquisition/corpus/
tag_acquisition/exports/

# =============================================================================
# Logs
# =============================================================================
*.log
logs/

# =============================================================================
# Temporary Files
# =============================================================================
tmp/
temp/
*.tmp
*.bak

# =============================================================================
# Databases / Local Cache
# =============================================================================
*.db
*.sqlite
*.sqlite3

# =============================================================================
# Vector / Retrieval Artifacts (future Phase 2)
# =============================================================================
*.faiss
*.index
*.npy

# =============================================================================
# Secrets
# =============================================================================
.env
.env.*

*.key
*.pem
*.secret
*.token
*.api_key

# dotenv local override
.env.local

# =============================================================================
# Source Data (release decision pending)
# =============================================================================
# tag.json contains real adult-domain tags.
# Keep ignored unless explicitly publishing dataset.

ontology_factory/tag.json

# Windows ADS metadata
*:Zone.Identifier

# =============================================================================
# OS Files
# =============================================================================

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Linux
.directory

# =============================================================================
# Shell / Session Snapshots
# =============================================================================
*.shell-snapshot

# =============================================================================
# Internal Docs / Planning Debris
# =============================================================================
docs/internal/

# =============================================================================
# Safety Check
# =============================================================================
# DO NOT ignore:
#   README.md
#   LICENSE
#   requirements.txt
#   tests/
#   docs/specs/
#   *.yaml
#   *.json schema/config files
# =============================================================================
# =============================================================================
# Tagger — runtime artifacts and secrets
# =============================================================================
# Run caches (stage1/stage2/final jsonl can reach tens of GB)
tagger/work/
# Local API keys — never commit. Same policy as .env above.
tagger/keys.txt

# Retrieval index is DERIVED from the adult-domain ontology, so it follows the
# same policy as ontology_factory/tag.json below. Rebuild with
# ontology_factory/build_faiss_index.py.
tagger/data/

# =============================================================================
# Adult-domain source data (harvested tag candidates, curated ontology, audits)
# Same policy as ontology_factory/tag.json: kept out unless explicitly
# publishing the dataset. The .py tooling under expansion/ IS tracked.
# =============================================================================
ontology_factory/input/
ontology_factory/rebuild/
ontology_factory/expansion/*.json
ontology_factory/expansion/*.tsv
ontology_factory/expansion/*.log
ontology_factory/expansion/*.txt

# Domain profile: adapters/config only; the file carries adult-domain taxonomy
# structure so it stays out of the public repo (disk copy retained).
ontology_factory/profiles/adult_profile.json

# Test fixtures derived from real novels (contain explicit passages).
# Deliberate exception to the "NEVER ignore test datasets" rule above: the repo
# should not publish novel text. There is no test code referencing them today;
# if tests are added, they must generate fixtures or skip when absent.
tests/data/acquisition/
tests/data/ontology/
